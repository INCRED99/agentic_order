# Supabase Project Configuration (Required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL (Required for production on Vercel)
# Example: https://restaurant-backend.onrender.com (without trailing slash)
# If omitted in local development, defaults to http://localhost:8000
VITE_API_URL=https://your-backend-api-url.com
